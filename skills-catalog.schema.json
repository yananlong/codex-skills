{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/codex-skills/skills-catalog.schema.json",
  "title": "Codex Skills Catalog",
  "description": "Open generated catalog for filesystem-backed Codex skills. This schema intentionally avoids closed enums so new domains, intents, capabilities, and resource types can be added without schema edits.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "catalog_version",
    "generated_by",
    "open_catalog",
    "skill_count",
    "domains",
    "skills"
  ],
  "properties": {
    "catalog_version": {
      "type": "integer",
      "minimum": 1
    },
    "generated_by": {
      "type": "string"
    },
    "open_catalog": {
      "const": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skill_count": {
      "type": "integer",
      "minimum": 0
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "path",
        "skill_file",
        "domain",
        "description",
        "primary_intent",
        "capabilities",
        "inputs",
        "outputs",
        "related_skills",
        "resources"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "skill_file": {
          "type": "string",
          "pattern": "SKILL\\.md$"
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "primary_intent": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "related_skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "frontmatter": {
          "type": "object",
          "additionalProperties": true
        },
        "agent_metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
